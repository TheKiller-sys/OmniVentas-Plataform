<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp">

    <!-- 🔥 NUEVO: HEADER CON DISEÑO PREMIUM -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/success"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_white">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_inventario"
                        android:tint="@color/white"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OMNIVENTAS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white_alpha_80"
                    android:letterSpacing="2"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventario"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consulta y controla tu stock"
                android:textSize="15sp"
                android:textColor="@color/white_alpha_80"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="@color/white"
                android:layout_marginTop="12dp"
                android:alpha="0.3" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- BÚSQUEDA ESTÉTICA -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_scan">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/white"
                    android:layout_gravity="center" />
            </FrameLayout>

            <EditText
                android:id="@+id/et_search_inventario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Buscar productos..."
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:textSize="16sp"
                android:textColor="@color/dark"
                android:textColorHint="@color/gray"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contador de productos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_stats_products"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 Productos"
            android:textSize="14sp"
            android:textColor="@color/gray" />

        <TextView
            android:id="@+id/tv_updated_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizado ahora"
            android:textSize="12sp"
            android:textColor="@color/success" />
    </LinearLayout>

    <!-- Filtros por categoría (dinámicos) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/ll_filtros_categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Grid de productos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_inventario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- Mensaje de inventario vacío -->
    <TextView
        android:id="@+id/tv_inventario_vacio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="No hay productos en el inventario"
        android:textSize="14sp"
        android:textColor="@color/gray"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

</LinearLayout>
